// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ORG_ADMIN
  TEAM_LEAD
  EMPLOYEE
  SYS_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BoardMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum CardStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Mood {
  HAPPY
  NEUTRAL
  STRESSED
  BLOCKED
}

enum NotificationType {
  CARD_ASSIGNED
  CARD_MOVED
  COMMENT_ADDED
  CARD_DUE_SOON
  MENTION
}

enum ActivityAction {
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_ASSIGNED
  CARD_DELETED
  COMMENT_ADDED
  STATUS_CHANGED
  PRIORITY_CHANGED
}

enum IntegrationType {
  SOAP
  REST
  WEBHOOK
}

enum ExportStatus {
  PENDING
  SUCCESS
  FAILED
}

// ============================================
// MODELS
// ============================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users              User[]
  teams              Team[]
  boards             Board[]
  integrationConfigs IntegrationConfig[]
  dailyExportLogs    DailyExportLog[]

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  email          String     @unique
  passwordHash   String     @map("password_hash")
  name           String
  role           UserRole   @default(EMPLOYEE)
  position       String?
  avatarUrl      String?    @map("avatar_url")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMembers     TeamMember[]
  boardMembers    BoardMember[]
  assignedCards   Card[]          @relation("AssignedCards")
  createdBoards   Board[]         @relation("CreatedBoards")
  createdCards    Card[]          @relation("CreatedCards")
  comments        Comment[]
  activityLogs    ActivityLog[]
  dailyStatuses   DailyStatus[]
  notifications   Notification[]
  dailyExportLogs DailyExportLog[]

  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMembers  TeamMember[]
  boards       Board[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Board {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  teamId         String?  @map("team_id")
  name           String
  description    String?
  createdBy      String   @map("created_by")
  isArchived     Boolean  @default(false) @map("is_archived")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creator      User          @relation("CreatedBoards", fields: [createdBy], references: [id])
  boardMembers BoardMember[]
  lists        List[]
  cards        Card[]

  @@index([organizationId])
  @@index([teamId])
  @@index([createdBy])
  @@index([isArchived])
  @@map("boards")
}

model BoardMember {
  id      String          @id @default(uuid())
  boardId String          @map("board_id")
  userId  String          @map("user_id")
  role    BoardMemberRole @default(MEMBER)
  addedAt DateTime        @default(now()) @map("added_at")

  // Relations
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
  @@map("board_members")
}

model List {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
  @@index([boardId, position])
  @@map("lists")
}

model Card {
  id            String        @id @default(uuid())
  boardId       String        @map("board_id")
  listId        String        @map("list_id")
  title         String
  description   String?
  assigneeId    String?       @map("assignee_id")
  status        CardStatus    @default(TODO)
  priority      CardPriority  @default(MEDIUM)
  estimateHours Decimal?      @map("estimate_hours") @db.Decimal(5, 2)
  dueDate       DateTime?     @map("due_date") @db.Date
  position      Int           @default(0)
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  // Relations
  board        Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list         List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("AssignedCards", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User          @relation("CreatedCards", fields: [createdBy], references: [id])
  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([boardId])
  @@index([listId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
  @@index([listId, position])
  @@map("cards")
}

model Comment {
  id        String   @id @default(uuid())
  cardId    String   @map("card_id")
  userId    String   @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
  @@map("comments")
}

model ActivityLog {
  id         String         @id @default(uuid())
  cardId     String         @map("card_id")
  userId     String?        @map("user_id")
  actionType ActivityAction @map("action_type")
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relations
  card Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model DailyStatus {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  date      DateTime  @db.Date
  summary   String
  blockers  String?
  mood      Mood?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@map("daily_statuses")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model IntegrationConfig {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  type           IntegrationType
  endpointUrl    String          @map("endpoint_url")
  credentials    Json            @default("{}")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("integration_configs")
}

model DailyExportLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  date           DateTime     @db.Date
  userId         String?      @map("user_id")
  status         ExportStatus @default(PENDING)
  requestPayload Json?        @map("request_payload")
  response       String?
  errorMessage   String?      @map("error_message")
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@map("daily_export_logs")
}
