# ========================================
# TeamBoard - Environment Configuration
# ========================================

# ----------------------------------------
# Application Environment
# ----------------------------------------
NODE_ENV=development
PORT=3000

# ----------------------------------------
# Database Configuration
# ----------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://teamboard_user:teamboard_pass@localhost:5432/teamboard_dev

# ----------------------------------------
# Authentication & Security
# ----------------------------------------
# JWT secret key (use a strong random string in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h

# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS=10

# ----------------------------------------
# CORS Configuration
# ----------------------------------------
# Allowed origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:4200

# ----------------------------------------
# SOAP Integration
# ----------------------------------------
# External SOAP service endpoint for daily summary export
SOAP_ENDPOINT_URL=https://external-hr-system.com/soap/endpoint
SOAP_USERNAME=soap_user
SOAP_PASSWORD=soap_password
SOAP_TIMEOUT=30000

# ----------------------------------------
# Logging
# ----------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# ----------------------------------------
# Rate Limiting
# ----------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ----------------------------------------
# Frontend Configuration (for build-time injection)
# ----------------------------------------
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=TeamBoard
VITE_APP_VERSION=1.0.0

# ----------------------------------------
# Email Configuration (Future Feature)
# ----------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@teamboard.com

# ----------------------------------------
# Cloud Storage (Future Feature - for file attachments)
# ----------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=teamboard-attachments

# ----------------------------------------
# Monitoring & Analytics (Optional)
# ----------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# DATADOG_API_KEY=your-datadog-api-key

# ----------------------------------------
# Docker Configuration
# ----------------------------------------
# PostgreSQL
POSTGRES_USER=teamboard
POSTGRES_PASSWORD=teamboard_password
POSTGRES_DB=teamboard
POSTGRES_PORT=5432

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ----------------------------------------
# Development Only
# ----------------------------------------
# Enable Swagger API documentation
ENABLE_SWAGGER=true

# Enable request logging
ENABLE_REQUEST_LOGGING=true
